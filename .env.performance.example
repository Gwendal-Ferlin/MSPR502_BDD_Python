# Configuration PERFORMANCE — copier en .env avant le lancement
# PC     : docker compose -f docker-compose-pc.yml -f docker-compose.performance.override.yml --profile performance up -d --build
# Serveur: docker compose -f docker-compose.performance.server.override.yml --profile performance up -d --build
# Stack allégée : pas de MinIO, Metabase, Prometheus, Grafana ; init-lite ; IA mockée

APP_PROFILE=performance
IA_MOCK_MODE=true
RATE_LIMIT_ENABLED=false

POSTGRES_UTILISATEUR_USER=utilisateur_user
POSTGRES_UTILISATEUR_PASSWORD=utilisateur_password

POSTGRES_SANTE_USER=sante_user
POSTGRES_SANTE_PASSWORD=sante_password

POSTGRES_GAMIFICATION_USER=gamification_user
POSTGRES_GAMIFICATION_PASSWORD=gamification_password

JWT_SECRET=dev-jwt-secret-change-me

DATA_ENCRYPTION_KEY=

MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=mspr502-medias
