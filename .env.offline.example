# Configuration OFFLINE — copier en .env avant le lancement
# PC     : docker compose -f docker-compose-pc.yml --profile offline up -d --build
# Serveur: docker compose --profile offline up -d --build
# Aucune connexion Internet requise : IA mockée (IA_MOCK_MODE=true)

APP_PROFILE=offline
IA_MOCK_MODE=true
RATE_LIMIT_ENABLED=true

POSTGRES_UTILISATEUR_USER=utilisateur_user
POSTGRES_UTILISATEUR_PASSWORD=utilisateur_password

POSTGRES_SANTE_USER=sante_user
POSTGRES_SANTE_PASSWORD=sante_password

POSTGRES_GAMIFICATION_USER=gamification_user
POSTGRES_GAMIFICATION_PASSWORD=gamification_password

JWT_SECRET=dev-jwt-secret-change-me

DATA_ENCRYPTION_KEY=

# Pas de HF_API_TOKEN — les routes /api/ia/* utilisent des réponses mock statiques

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000
# Serveur : http://<IP>:19000
MINIO_BUCKET=mspr502-medias
