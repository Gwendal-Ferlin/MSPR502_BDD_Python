# Configuration COMPLÈTE — copier en .env avant le lancement
# PC     : docker compose -f docker-compose-pc.yml --profile complete up -d --build
# Serveur: docker compose --profile complete up -d --build

APP_PROFILE=complete
IA_MOCK_MODE=false
RATE_LIMIT_ENABLED=true

POSTGRES_UTILISATEUR_USER=utilisateur_user
POSTGRES_UTILISATEUR_PASSWORD=utilisateur_password

POSTGRES_SANTE_USER=sante_user
POSTGRES_SANTE_PASSWORD=sante_password

POSTGRES_GAMIFICATION_USER=gamification_user
POSTGRES_GAMIFICATION_PASSWORD=gamification_password

JWT_SECRET=dev-jwt-secret-change-me

# Clé de démo (alignée sur init/postgres-sante/02_seed.sql) — voir .env.example
DATA_ENCRYPTION_KEY=

# Hugging Face — requis pour l'IA réelle (POST /api/ia/*)
# https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_TIMEOUT_SEC=45

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000
# Serveur : http://<IP>:19000
MINIO_BUCKET=mspr502-medias

METABASE_PORT=3000
METABASE_SITE_URL=http://localhost:13000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
# Serveur : adapter METABASE_SITE_URL et GRAFANA_ROOT_URL (ports 13000 / 13001)
